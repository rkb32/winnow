{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteUploadsSavedAndScanLog",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::winnow-test-073868306412/uploads/*",
        "arn:aws:s3:::winnow-test-073868306412/saved/*",
        "arn:aws:s3:::winnow-test-073868306412/scan-log/*"
      ]
    },
    {
      "Sid": "ReadAndDeleteSavedPhotos",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::winnow-test-073868306412/saved/*"
    },
    {
      "Sid": "ListUploadsSavedAndScanLog",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::winnow-test-073868306412",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["uploads/*", "saved/*", "scan-log/*"]
        }
      }
    },
    {
      "Sid": "StartScanTask",
      "Effect": "Allow",
      "Action": "ecs:RunTask",
      "Resource": "arn:aws:ecs:us-east-1:073868306412:task-definition/winnow-task:*",
      "Condition": {
        "ArnEquals": {
          "ecs:cluster": "arn:aws:ecs:us-east-1:073868306412:cluster/winnow-cluster"
        }
      }
    },
    {
      "Sid": "CountRunningScans",
      "Effect": "Allow",
      "Action": "ecs:ListTasks",
      "Resource": "*",
      "Condition": {
        "ArnEquals": {
          "ecs:cluster": "arn:aws:ecs:us-east-1:073868306412:cluster/winnow-cluster"
        }
      }
    },
    {
      "Sid": "PassTaskRolesToEcs",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::073868306412:role/winnowTaskExecutionRole",
        "arn:aws:iam::073868306412:role/winnowTaskRole"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    }
  ]
}
